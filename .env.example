# ─── Backend ───────────────────────────────────────────────
# Conexión a Postgres (local docker-compose por defecto)
DATABASE_URL=postgresql+psycopg2://laburapp:laburapp@db:5432/laburappdb

# Seguridad JWT — generar uno real con: openssl rand -hex 32
SECRET_KEY=changeme-genera-uno-con-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (orígenes del frontend, separados por coma)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Entorno: local | production
ENVIRONMENT=local

# ─── Postgres (docker-compose) ─────────────────────────────
POSTGRES_USER=laburapp
POSTGRES_PASSWORD=laburapp
POSTGRES_DB=laburappdb
