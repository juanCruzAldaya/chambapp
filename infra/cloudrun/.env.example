# Configuración para los scripts de despliegue en Cloud Run.
# Copiar a `.env` (gitignored) y completar PROJECT_ID.
#   cp .env.example .env

# ─── Proyecto / región ─────────────────────────────────────
PROJECT_ID=mi-proyecto-gcp
REGION=us-central1

# ─── Artifact Registry (repo de imágenes Docker) ───────────
AR_REPO=chambapp

# ─── Cloud SQL (Postgres) ──────────────────────────────────
DB_INSTANCE=chambapp-db
DB_NAME=chambappdb
DB_USER=chambapp
DB_TIER=db-f1-micro

# ─── Servicios Cloud Run ───────────────────────────────────
API_SERVICE=chambapp-api
WEB_SERVICE=chambapp-web
