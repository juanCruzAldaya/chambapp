# Config para los scripts de GKE. Copiar a `.env` (gitignored) y completar.
#   cp .env.example .env

# ─── Proyecto / región ─────────────────────────────────────
PROJECT_ID=mi-proyecto-gcp
REGION=us-central1

# ─── GKE ───────────────────────────────────────────────────
CLUSTER=chambapp

# ─── Artifact Registry (reusa el de Cloud Run si ya existe) ─
AR_REPO=chambapp

# ─── Cloud SQL (Postgres) ──────────────────────────────────
DB_INSTANCE=chambapp-db
DB_NAME=chambappdb
DB_USER=chambapp
DB_TIER=db-f1-micro

# ─── Workload Identity ─────────────────────────────────────
# Service account de Google que el proxy usa para llegar a Cloud SQL.
GSA_NAME=chambapp-gke
